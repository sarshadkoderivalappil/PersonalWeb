.DS_Store

# Everything in here is off-limits to git, whatever it is. Your CV, the
# video, and anything else that isn't part of the published site belongs
# in this one folder — it's the single place to check before a push.
private/

# Belt-and-suspenders: block these file types everywhere else in the repo
# too, so a stray document dropped outside private/ doesn't slip through.
# To publish a specific file on purpose (e.g. a preprint PDF), override
# with: git add -f path/to/file.pdf
*.docx
*.doc
*.pdf
*.pptx
*.key
*.mp4
*.mov
*.m4v
